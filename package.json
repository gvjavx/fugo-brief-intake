{
  "name": "fugo-brief-intake",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/dev.ts\" \"vite\"",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "db:migrate": "tsx --env-file-if-exists=.env server/migrate.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@vercel/functions": "^3.11.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "private": "true"
